[Unit]
Description=Sovereign Bare-Metal LLM Appliance (Qwen 2.5 14B Coder)
After=network.target

[Service]
Type=simple
User=predator
Environment="HIP_VISIBLE_DEVICES=0"
Environment="HSA_OVERRIDE_GFX_VERSION=11.0.0"
ExecStart=/usr/local/bin/llama-server   -m /home/predator/models/qwen2.5-coder-14b-instruct-q4_k_m-00001-of-00002.gguf   -c 16384   -b 1024   -ub 512   -ngl 99   --no-mmap   --host 127.0.0.1   --port 8080
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
